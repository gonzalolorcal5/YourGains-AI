# ════════════════════════════════════════════════════════
# CONFIGURACIÓN DE ENTORNO - Copiar a .env y rellenar valores
# ════════════════════════════════════════════════════════

# Detectar entorno: local (SQLite) | production (PostgreSQL Railway)
ENVIRONMENT=local

# ════════════════════════════════════════════════════════
# BASE DE DATOS - LOCAL (SQLite)
# ════════════════════════════════════════════════════════
DATABASE_URL_LOCAL=sqlite:///./yourgains_local.db

# ════════════════════════════════════════════════════════
# BASE DE DATOS - PRODUCCIÓN (Railway PostgreSQL)
# ════════════════════════════════════════════════════════
DATABASE_URL_PRODUCTION=postgresql://user:password@host:port/railway

# Usar local o producción según ENVIRONMENT
DATABASE_URL=${DATABASE_URL_LOCAL}

# ════════════════════════════════════════════════════════
# OpenAI
# ════════════════════════════════════════════════════════
OPENAI_API_KEY=tu_clave_openai_aqui
OPENAI_MODEL=gpt-4o

# ════════════════════════════════════════════════════════
# JWT
# ════════════════════════════════════════════════════════
SECRET_KEY=tu_secret_key_super_segura_aqui
ALGORITHM=HS256

# ════════════════════════════════════════════════════════
# Stripe (pagos)
# ════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
